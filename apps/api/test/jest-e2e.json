{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@workspace/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
    "^@workspace/db$": "<rootDir>/../../../packages/db/generated/client/index.js"
  }
}
