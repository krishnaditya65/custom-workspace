# Postgres connection string consumed by @workspace/db (Prisma) and this app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workspace?schema=public"

# Redis connection string. Used for: @nestjs/throttler storage backend,
# API-side ephemeral pub/sub (typing indicators / presence pings), and the
# graphql-redis-subscriptions PubSub used by messageAdded so subscriptions
# fan out correctly across horizontally scaled API instances.
REDIS_URL="redis://localhost:6379"

# HS256 signing secret for short-lived (15m) access tokens. Generate with
# e.g. `openssl rand -hex 32` in every real environment - never reuse this
# example value.
JWT_ACCESS_SECRET="change-me-access-secret"

# Extra static pepper mixed into refresh-token hashing before it is stored,
# so a DB leak alone (without this env secret) can't be used to forge/replay
# refresh tokens. Generate with `openssl rand -hex 32`.
JWT_REFRESH_PEPPER="change-me-refresh-pepper"

# HTTP port the Nest app listens on.
PORT=4000

# Comma-separated list of allowed CORS origins, or "*" for all (dev only).
CORS_ORIGIN="http://localhost:3000"

# Shared secret required on the `x-internal-secret` header for the
# service-to-service `/internal/*` routes (currently just
# POST /internal/sessions/verify, called by apps/sync). MUST be byte-identical
# to apps/sync's INTERNAL_SERVICE_SECRET. Generate with `openssl rand -hex 32`
# in every real environment - never reuse this example value. `/internal/*`
# should also never be reachable through the public gateway/load balancer;
# this header is defense-in-depth on top of that network boundary, not a
# substitute for it.
INTERNAL_SERVICE_SECRET="change-me-internal-service-secret"
