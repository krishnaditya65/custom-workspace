# apps/web environment variables
# Copy to .env(.local) and adjust for your environment.

# apps/api GraphQL HTTP origin (NestJS GraphQL server). In dev, /graphql is
# also proxied by Vite (see vite.config.ts) so this mostly matters for prod
# builds served statically (see Dockerfile/nginx.conf).
VITE_API_URL=http://localhost:4000

# apps/sync Hocuspocus WebSocket origin, used by CollabEditor.tsx and
# Whiteboard.tsx to open per-document/per-board Y.Doc sync sessions.
VITE_WS_URL=ws://localhost:1234

# LiveKit server URL (self-hosted or LiveKit Cloud) used by Huddle.tsx for
# voice/video calls. Leave unset to render the "LiveKit server not
# configured" scaffold state instead of attempting a connection.
VITE_LIVEKIT_URL=
