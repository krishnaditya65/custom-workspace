# HTTP/WS port this instance listens on.
PORT=1234

# Same Postgres database apps/api uses (raw SQL against the Prisma-managed schema).
DATABASE_URL="postgresql://workspace:workspace@localhost:5432/workspace?schema=public"

# Redis connection used for cross-instance pub/sub fan-out when running >1 replica.
# If unreachable at startup, the instance logs a warning and runs standalone
# (correct for single-instance dev, not for horizontal scale-out).
REDIS_URL="redis://localhost:6379"

# Origin of apps/api, used to call POST /internal/sessions/verify on every
# new WebSocket connection — apps/api is the single source of truth for
# session validity and effective RBAC permission, so this service no longer
# verifies JWTs or computes the permission matrix itself.
API_BASE_URL="http://localhost:4000"

# MUST be byte-identical to apps/api's INTERNAL_SERVICE_SECRET — sent as the
# x-internal-secret header on calls to POST /internal/sessions/verify.
INTERNAL_SERVICE_SECRET="change-me-internal-service-secret"

# Timeout (ms) for the /internal/sessions/verify HTTP call. A connection is
# rejected outright if this is exceeded or the call otherwise fails — there
# is no local fallback verification path.
SESSION_VERIFY_TIMEOUT_MS=3000

# Write-behind debounce window in milliseconds (see internal/hub/room.go).
# Lowered in integration tests; production default is 10000 (10s).
SNAPSHOT_DEBOUNCE_MS=10000

# Optional: identifies this replica in Redis pub/sub so it can ignore its own
# published events. Defaults to "<hostname>-<pid>" if unset.
INSTANCE_ID=
