{
  "name": "custom-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Unified real-time collaborative workspace (chat, docs, whiteboard, huddles)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./apps/* run build",
    "test": "pnpm -r --filter=./apps/* run test",
    "test:unit": "pnpm -r --filter=./apps/* run test:unit",
    "test:e2e": "pnpm -r --filter=./apps/* run test:e2e",
    "bench": "node bench/run-all.mjs",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker-compose.yml down -v",
    "prisma:generate": "pnpm --filter @workspace/db run generate",
    "prisma:migrate": "pnpm --filter @workspace/db run migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
